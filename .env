# ─── Database ──────────────────────────────────────────────────────────
# Use 'localhost' when running tests/app directly; 'postgres' inside Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hackathon5
POSTGRES_USER=postgres
POSTGRES_PASSWORD=waleedkhan

# ─── Kafka ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=fte-message-processor

# ─── Channels ──────────────────────────────────────────────────────────
GMAIL_ENABLED=true
WHATSAPP_ENABLED=false
WEBFORM_ENABLED=true

# ─── Response Limits ───────────────────────────────────────────────────
MAX_EMAIL_LENGTH=2000
MAX_WHATSAPP_LENGTH=1600
MAX_WEBFORM_LENGTH=1000

# ─── Agent Behavior ────────────────────────────────────────────────────
ESCALATION_SENTIMENT_THRESHOLD=0.3
CONVERSATION_WINDOW_HOURS=24
MAX_KB_RESULTS=5

# ─── OpenAI Model Config ───────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.3

# ─── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Environment ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
