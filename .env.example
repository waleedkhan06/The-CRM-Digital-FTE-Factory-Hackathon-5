# Customer Success FTE — Environment Variables Template
# Copy this file to .env and fill in your values:
# cp .env.example .env

# ─── OpenAI (Optional / Primary) ───────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.3

# ─── Groq (Free LLM Alternative) ───────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── OpenRouter (Fallback Free Models) ─────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=tencent/hy3-preview:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-m.1:free

# ─── Database ──────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hackathon5
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password-here

# ─── Kafka ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=fte-message-processor

# ─── Channels ──────────────────────────────────────────────────────────
GMAIL_ENABLED=false
WHATSAPP_ENABLED=false
WEBFORM_ENABLED=true

# ─── Meta WhatsApp Cloud API ───────────────────────────────────────────
META_WA_PHONE_NUMBER_ID=your-meta-phone-number-id
META_WA_ACCESS_TOKEN=your-meta-access-token
META_WA_VERIFY_TOKEN=your-meta-verify-token
META_WA_APP_SECRET=your-meta-app-secret

# ─── Gmail OAuth / Credentials ─────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=credentials/gmail_token.json
GMAIL_CLIENT_SECRET_FILE=credentials/client_secret.json

# ─── Response Limits ───────────────────────────────────────────────────
MAX_EMAIL_LENGTH=2000
MAX_WHATSAPP_LENGTH=1600
MAX_WEBFORM_LENGTH=1000

# ─── Agent Behavior ────────────────────────────────────────────────────
ESCALATION_SENTIMENT_THRESHOLD=0.3
CONVERSATION_WINDOW_HOURS=24
MAX_KB_RESULTS=5

# ─── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Environment ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
