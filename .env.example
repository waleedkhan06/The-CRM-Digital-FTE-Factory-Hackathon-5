# Customer Success FTE — Environment Variables Template
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── OpenAI (Required) ─────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── Database (Required) ───────────────────────────────────────────────
# Get from: Supabase, Neon, or your PostgreSQL provider
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fte_db
POSTGRES_USER=fte_user
POSTGRES_PASSWORD=your-secure-password

# ─── Kafka (Required for production, optional for local) ───────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=fte-message-processor

# ─── Gmail Channel (Optional — skip for local testing) ─────────────────
# Get from: Google Cloud Console → Service Account → JSON key
# Save the JSON file as: credentials/gmail-credentials.json
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_PATH=credentials/gmail-credentials.json
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-inbox

# ─── WhatsApp Channel (Optional — skip for local testing) ──────────────
# Get from: https://console.twilio.com → Account SID, Auth Token
TWILIO_ACCOUNT_SID=AC_your-account-sid-here
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_ENABLED=false

# ─── Web Form Channel ──────────────────────────────────────────────────
WEBFORM_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Response Limits ───────────────────────────────────────────────────
MAX_EMAIL_LENGTH=2000
MAX_WHATSAPP_LENGTH=1600
MAX_WEBFORM_LENGTH=1000

# ─── Agent Behavior ────────────────────────────────────────────────────
ESCALATION_SENTIMENT_THRESHOLD=0.3
CONVERSATION_WINDOW_HOURS=24
MAX_KB_RESULTS=5

# ─── OpenAI Model Configuration ────────────────────────────────────────
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.3

# ─── Environment ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
